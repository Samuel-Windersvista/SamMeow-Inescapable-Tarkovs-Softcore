<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>InescapableTarkovsSoftcore</AssemblyName>
    <RootNamespace>InescapableTarkovsSoftcore</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- 默认配置模板：随包分发（build.ps1 拷贝为 config.json）并内嵌为运行时重建来源 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\config\default-config.json" LogicalName="InescapableTarkovsSoftcore.default-config.json" />
  </ItemGroup>

  <!-- G2 True Items Redux 查找表：源 = 旧包 IMM 覆盖层，嵌入程序集运行时读取 -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\trueitems\barter.json" LogicalName="InescapableTarkovsSoftcore.trueitems.barter.json" />
    <EmbeddedResource Include="..\..\data\trueitems\clothing.json" LogicalName="InescapableTarkovsSoftcore.trueitems.clothing.json" />
    <EmbeddedResource Include="..\..\data\trueitems\keycards.json" LogicalName="InescapableTarkovsSoftcore.trueitems.keycards.json" />
    <EmbeddedResource Include="..\..\data\trueitems\medicals.json" LogicalName="InescapableTarkovsSoftcore.trueitems.medicals.json" />
    <EmbeddedResource Include="..\..\data\trueitems\partsnmods.json" LogicalName="InescapableTarkovsSoftcore.trueitems.partsnmods.json" />
    <EmbeddedResource Include="..\..\data\trueitems\provisions.json" LogicalName="InescapableTarkovsSoftcore.trueitems.provisions.json" />
  </ItemGroup>

</Project>
