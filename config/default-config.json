{
  // Inescapable Tarkov's Softcore —— 默认配置
  // 本文件支持 // 注释与尾随逗号；改动后需重启 SPT 服务器生效。
  "general": {
    // 总开关：false 时跳过全部功能模块
    "enabled": true,
    // 调试模式：输出更详细日志（各模块自行决定是否读取）
    "debug": false
  },

  // 以下各功能组开关；具体参数随各自工单扩展
  "samuelTweaks": {
    // G1 总开关
    "enabled": true,
    // 护甲弹挂冲突修复：含 RigLayoutName 的弹挂甲 → BlocksArmorVest=false
    "armorConflictFix": true,
    // 可掠夺物品
    "lootableItems": {
      // 臂章（父类 5447e1d04bdc2dff2f8b4567）可掠夺
      "armband": true,
      // 近战武器（类目 5b3f15d486f77432d0509248）可掠夺
      "meleeWeapons": true
    },
    // 扩展弹匣缩格：宽 1 且高 >2 且容量在 [minCapacity, maxCapacity] → 高 2、ExtraSizeDown−1
    "magazineResize": {
      "enabled": true,
      "minCapacity": 10,
      "maxCapacity": 50
    },
    // 启动器自定义背景（构建期静态件：assets/launcher/bg.png → SPT_Data/images/launcher/bg.png）
    "customBackground": true
  },
  "trueItems": {
    "enabled": true,
    // 逐物品/父类微调：id → 目标堆叠值（最后应用，覆盖内嵌查找表）
    "overrides": {}
  },
  "noFirHideout": {
    "enabled": true
  },
  "antigravArmbands": {
    "enabled": true,
    // 全部臂章的堆叠上限
    "stackSize": 5,
    // 单品覆盖：臂章 id → 重量（最后应用，覆盖内嵌查找表）
    "overrides": {}
  },
  "backpacks": {
    "enabled": true
  },
  "softcore": {
    // Softcore 经济与制造系统大修（子结构对齐源 config.json5；数值为 SURV 终态）
    "enabled": true,
    "secureContainersOptions": {
      // 渐进式安全容器：新档 2×2 腰包起步，逐级升级到 Kappa
      "enabled": true,
      "progressiveContainers": {
        "enabled": true,
        // 收藏家任务重做：20 级可接，仅需交 1 张 Gamma
        "collectorQuestRedone": true
      },
      // 放宽容器尺寸：Alpha 3×3 / Beta 3×4 / Epsilon 3×5 / Gamma 4×5 / Kappa 5×5
      "biggerContainers": true
    },
    "stashOptions": {
      "enabled": true,
      // 新档从 LVL1 仓库起步
      "progressiveStash": true,
      // 扩容至 50/100/150/200 行
      "biggerStash": true,
      // 仓库建造现金需求 ÷10
      "lessCurrencyForConstruction": true,
      // 降低阶段建造忠诚度要求（SURV 关闭）
      "easierLoyalty": false
    },
    "hideoutContainers": {
      "enabled": true,
      // 藏身处容器扩容（SURV 终态，cellsV×cellsH）：药品 10×10 / Holodilnick 10×10 /
      // 弹匣 7×10 / 物品 6×6 / 武器 6×7 / 钥匙工具 5×5 / THICC 武器 6×14 / THICC 物品 6×14
      "biggerHideoutContainers": true,
      // SICC 增强：并入 Docs 允许清单并允许钥匙工具
      "siccCaseBuff": true
    }
  },

  // 战局时长控制：multiplier 为全局倍率，1.0 = 原版时长
  "raidDuration": {
    "enabled": true,
    "multiplier": 1.0
  }
}
